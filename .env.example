# Copy to .env for local non-Docker runs (docker-compose.yml sets its own values).
# NEVER commit a real .env — it is gitignored.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (dj-database-url format). Docker compose injects its own postgres:// URL.
DATABASE_URL=postgres://plantgpt:plantgpt@localhost:5432/plantgpt

# Anthropic — only needed once the conversational layer lands (M5+). Host secret in prod.
ANTHROPIC_API_KEY=
